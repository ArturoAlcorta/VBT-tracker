# Copy to .env and adjust. docker-compose.yml already provides sane defaults
# for DATABASE_URL (the bundled Postgres); the two below are the ones you
# need to point at your own Redis/RabbitMQ instances (see README).

CELERY_BROKER_URL=amqp://guest:guest@your-rabbitmq-host:5672//
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/0
REDIS_URL=redis://your-redis-host:6379/0

# "cpu" works everywhere; set to "0" for the first CUDA GPU (needs the
# nvidia-container-toolkit — see the commented block in docker-compose.yml).
DEVICE=cpu
